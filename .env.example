# --- LLM providers ---
# Primary: DeepSeek (OpenAI-compatible). Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Fallback: Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional overrides (sane defaults applied if unset) ---
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# GEMINI_MODEL=gemini-2.0-flash
# LLM_TIMEOUT=90

# Where the SQLite DB lives (defaults to data/applications.db)
# JOB_AGENT_DB=data/applications.db

# --- Memory (Chroma vector store) ---
# Where Chroma persists (defaults to data/chroma)
# JOB_AGENT_CHROMA_DIR=data/chroma
# Set to 1 to use real semantic embeddings (downloads a ~79MB ONNX model once).
# Default (unset) uses a no-op embedding — memory works via metadata, no download.
# JOB_AGENT_MEMORY_EMBED=1

# --- Observability (optional) ---
# Set a LangSmith key to also stream native LangGraph traces to LangSmith.
# Without it, local structlog JSON tracing + the SQLite-backed dashboard are used.
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=job-agent
